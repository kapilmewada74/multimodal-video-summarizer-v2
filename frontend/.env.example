# Web app settings. For local work copy to frontend/.env.local.
# Everything starting with NEXT_PUBLIC_ is compiled into the browser code: PUBLIC values only, never a secret.
# In production these are passed as build arguments (GitHub: Settings > Variables) and need a rebuild to change.

NEXT_PUBLIC_SUPABASE_URL=
# The project's publishable key (sb_publishable_...) - meant to be public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site (links, sitemap, social previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on the Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# Optional privacy-friendly analytics (Plausible). Leave empty to switch analytics off.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_ANALYTICS_HOST=https://plausible.io

# Development proxy target for /api (server-side only)
# BACKEND_API_URL=http://127.0.0.1:8000
