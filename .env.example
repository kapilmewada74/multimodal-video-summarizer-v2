# ============================================================
# Multimodal Video Summarizer: environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ============================================================

# --- Database (required) ---
# Supabase Postgres connection string.
# Local Supabase (`supabase start`):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Supabase dashboard > Project Settings > Database > Connection string (use the pooler).
DATABASE_URL=

# --- Sign-in verification (required) ---
# Your project URL (Dashboard > Project Settings > API). Used to verify tokens
# signed with the project's public keys.
SUPABASE_URL=
# Only for older projects that still sign tokens with a shared secret
# (Project Settings > API > JWT secret). Leave empty if your project uses public signing keys.
SUPABASE_JWT_SECRET=
# Needed only when FILE_STORE=supabase. Keep it secret: it bypasses all access rules.
SUPABASE_SERVICE_ROLE_KEY=

# --- Summary generation (at least one provider key is required) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-20b
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# xAI Grok (quiz, optional): https://console.x.ai/
XAI_API_KEY=

# --- Optional settings ---
# development (default) | production. In production the API does not run jobs
# itself: start one or more workers with
#   python -m summarizer.features.jobs.worker
# ENVIRONMENT=development
# Run the worker inside the API process (default: on in development, off in production)
# RUN_EMBEDDED_WORKER=true
# Where uploads are kept between the API and the worker: local | supabase
# FILE_STORE=local
# SUPABASE_STORAGE_BUCKET=uploads
# Browser origins allowed to call the API (comma separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Largest accepted upload (MB) and longest accepted video (seconds)
# MAX_UPLOAD_MB=500
# MAX_VIDEO_SECONDS=10800
# Videos one network address may submit per day (on top of the per-user limit of 10)
# IP_DAILY_LIMIT=30
# Documents: largest single file (MB), storage per user (MB), file count per user
# MAX_DOCUMENT_MB=25
# USER_STORAGE_QUOTA_MB=2048
# MAX_DOCUMENTS_PER_USER=500
# Secret for short-lived file download/stream links (defaults to a key derived from the JWT secret)
# STREAM_SIGNING_KEY=
# AI generations (flashcards, quiz, mind map, slides) one user may trigger per day.
# Opening an output that already exists is free and not counted.
# GENERATION_DAILY_LIMIT=60
# Study time that makes a day count toward the streak, in seconds (default 600 = 10 minutes)
# STREAK_MIN_SECONDS=600
# Public address of the web app (used for links inside emails)
# APP_URL=http://localhost:3000
# Email notifications through Resend (https://resend.com). Off when RESEND_API_KEY is empty.
# RESEND_API_KEY=
# EMAIL_FROM=Summarize <notifications@your-domain.com>
# Browser push notifications. Generate a key pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Behind a reverse proxy, trust the X-Forwarded-For header for the client address
# TRUST_PROXY=1
# Change this to any random text in production (used to hash addresses)
# IP_HASH_SALT=
# Whisper model size: tiny, base, small, medium, large-v3
# WHISPER_MODEL=small
# Where uploads and temporary media are kept
# DATA_DIR=./data
