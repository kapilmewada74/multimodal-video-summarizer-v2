# Worker image for a machine with an NVIDIA GPU (Whisper on CUDA).
# faster-whisper 1.2 needs CUDA 12 and cuDNN 9; the runtime image below provides both.
# The host needs the NVIDIA driver and the NVIDIA Container Toolkit; run with `--gpus all`.
FROM nvidia/cuda:13.5.0-cudnn-runtime-ubuntu24.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY backend/summarizer ./backend/summarizer
COPY assets ./assets

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p data \
    && chown -R appuser:appuser /app/data /home/appuser
USER appuser
WORKDIR /app/backend

ARG RELEASE=dev
ENV RELEASE=${RELEASE} \
    ENVIRONMENT=production \
    LOG_FORMAT=json \
    WHISPER_MODEL=large-v3

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD python3 -m summarizer.features.jobs.worker --healthcheck

ENTRYPOINT ["tini", "--"]
CMD ["python3", "-m", "summarizer.features.jobs.worker"]
