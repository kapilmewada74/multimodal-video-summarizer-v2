# Production settings for docker-compose.prod.yml. Copy to .env.production on the SERVER
# (never commit it). Every value marked REQUIRED is checked at start-up: the API refuses
# to start with an unsafe configuration and prints what to fix.

# --- Where the site lives ---
SITE_ADDRESS=app.example.com                 # REQUIRED  your domain (DNS A record -> this server)
APP_URL=https://app.example.com              # REQUIRED  https address of the site
CORS_ORIGINS=https://app.example.com         # REQUIRED  same as APP_URL
TRUST_PROXY=1

# --- Image to run (set by the deploy workflow; pin a commit for rollbacks) ---
REGISTRY=ghcr.io/rahuldhakad01/multimodal-video-summarizer
IMAGE_TAG=latest

# --- Supabase (production project) ---
DATABASE_URL=                                # REQUIRED  Project Settings > Database > Connection string (pooler)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co  # REQUIRED
SUPABASE_SERVICE_ROLE_KEY=                   # REQUIRED for FILE_STORE=supabase. SECRET: bypasses all access rules.
FILE_STORE=supabase                          # REQUIRED to run more than one server
SUPABASE_STORAGE_BUCKET=uploads

# --- Secrets you generate:  openssl rand -hex 32 ---
STREAM_SIGNING_KEY=                          # REQUIRED  signs short-lived file links, shared by every API copy
IP_HASH_SALT=                                # REQUIRED
OPS_TOKEN=                                   # optional: enables /api/internal/stats for the monitor

# --- AI providers (at least one) ---
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- Email (Resend) and push ---
RESEND_API_KEY=
EMAIL_FROM=Summarize <notifications@your-domain.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# --- Operations ---
SENTRY_DSN=
WHISPER_MODEL=small                          # use the model chosen by scripts/benchmark_whisper.py
LOG_FORMAT=json
DB_POOL_MAX=10
